extends SceneTree
var checks: Array = []
func check(value: bool, label: String) -> void:
	checks.append({"name":label,"passed":value})
	if not value: push_error(label)
func _initialize() -> void: call_deferred("run")
func ids(snapshot: Dictionary) -> Array[String]:
	var result: Array[String] = []
	for selection in snapshot.selectedEffects:
		for id in selection.effectIds:
			if not id in result: result.append(id)
	return result
func run() -> void:
	var f: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://fixture.json"))
	var script = load("res://effect_rule_controller.gd")
	var rules = script.new()
	check(rules.configure_trusted(f.plan,f.effects,"hero-1"),"bounded trusted configuration")
	check(rules.observe(f.initial),"owner facts")
	check(rules.capture_attack(f.nullTarget).is_empty()==f.expected.nullTargetRejected,"JS differential explicit null target rejection")
	check(rules.capture_attack(f.omittedTarget)==f.expected.omittedSnapshot,"JS differential omitted target acceptance")
	rules.cancel_attack("omitted-target",1)
	check(rules.select_while_active()==f.expected.active,"JS differential active selection")
	var captured: Dictionary = rules.capture_attack(f.action)
	check(captured==f.expected.snapshot,"JS differential priority tie snapshot")
	captured.selectedEffects.clear()
	check(rules.capture_attack(f.action)==f.expected.snapshot,"defensive snapshot copies")
	check(rules.retain_projectile("last",1,"early").is_empty(),"release boundary required")
	rules.mark_released("last",1)
	var first: Dictionary = rules.retain_projectile("last",1,"one")
	var second: Dictionary = rules.retain_projectile("last",1,"two")
	rules.observe(f.consumed)
	var next: Dictionary = rules.capture_attack(f.nextAction)
	check(first==second and first==f.expected.snapshot,"last-charge multi-projectile retention")
	check(next==f.expected.next and rules.select_while_active().is_empty(),"JS differential next attack refresh")
	var renderer = load("res://effect_controller.gd").new()
	root.add_child(renderer)
	renderer.register_tint("green",Color(0,1,0,1))
	var image := Image.create(16,16,false,Image.FORMAT_RGBA8)
	image.fill(Color.WHITE)
	var texture := ImageTexture.create_from_image(image)
	var arrow := Sprite2D.new()
	arrow.texture=texture
	arrow.position=Vector2(32,32)
	root.add_child(arrow)
	var ordinary := Sprite2D.new()
	ordinary.texture=texture
	ordinary.position=Vector2(96,32)
	root.add_child(ordinary)
	check(renderer.apply_projectile("last-one",arrow,ids(first),0),"render retained snapshot")
	check(renderer.apply_projectile("next",ordinary,ids(next),0),"render next attack")
	await process_frame
	await RenderingServer.frame_post_draw
	var frame := root.get_texture().get_image()
	frame.save_png("res://last-charge-and-next.png")
	check(frame.get_pixel(32,32).g>0.9 and frame.get_pixel(32,32).r<0.1,"rendered retained green projectile")
	check(frame.get_pixel(96,32).r>0.9 and frame.get_pixel(96,32).g>0.9,"rendered next ordinary projectile")
	rules.complete_attack("last",1)
	rules.release_projectile("last",1,"one")
	check(rules.status().pending==2,"completed attack retains remaining projectile")
	rules.release_projectile("last",1,"two")
	check(rules.status().pending==1 and rules.capture_attack(f.action).is_empty(),"retire final reference and reject reused generation")
	var fresh: Dictionary = f.nextAction.duplicate(true)
	fresh.generation=2
	check(not rules.capture_attack(fresh).is_empty(),"new generation isolates reused ID")
	check(not rules.observe(f.initial),"stale facts rejected")
	var conflict: Dictionary = f.consumed.duplicate(true)
	conflict.bindings.a={"present":true,"amount":1}
	check(not rules.observe(conflict) and not rules.observe(f.consumed),"conflicting sequence quarantined")
	check(rules.advance(10) and rules.status().pending==0 and not rules.advance(9),"native expiry and monotonic clock")
	check(f.initial.bindings.a.amount==1 and f.consumed.bindings.a.amount==0,"gameplay facts untouched")
	var budget = script.SceneBudget.new()
	budget.limit=1
	var left = script.new()
	var right = script.new()
	left.configure_trusted(f.plan,f.effects,"hero-1",budget)
	right.configure_trusted(f.plan,f.effects,"hero-1",budget)
	left.observe(f.initial)
	right.observe(f.initial)
	left.capture_attack(f.action)
	check(right.capture_attack(f.action).is_empty(),"shared scene cap")
	check(right.status().diagnostics.has("Presentation snapshot capacity exceeded: scene"),"scene capacity diagnostic")
	left.cancel_attack("last",1)
	check(not right.capture_attack(f.action).is_empty(),"cancellation releases scene capacity")
	right.dispose()
	check(budget.used==0 and budget.projectiles==0,"dispose releases ownership")
	var bounded = script.new()
	bounded.configure_trusted(f.plan,f.effects,"hero-1")
	bounded.observe(f.initial)
	for i in range(32):
		var action: Dictionary = f.action.duplicate(true)
		action.actionInstance="pending-"+str(i)
		bounded.capture_attack(action)
	for i in range(200): bounded.capture_attack(f.action)
	check(bounded.status().pending==32 and bounded.status().diagnostics==["Exclusive channel tip owners=a(mod.a),z(mod.z) winner=a","Presentation snapshot capacity exceeded: pending"],"pending exhaustion diagnostic bounded and deduplicated")
	bounded.dispose()
	var history = script.new()
	history.configure_trusted(f.plan,f.effects,"hero-1")
	history.observe(f.initial)
	for i in range(1024):
		var action: Dictionary = f.action.duplicate(true)
		action.actionInstance="history-"+str(i)
		history.capture_attack(action)
		history.cancel_attack(action.actionInstance,1)
	check(history.capture_attack(f.action).is_empty() and history.status().diagnostics.has("Presentation snapshot capacity exceeded: history"),"history capacity diagnostic")
	history.dispose()
	rules.dispose()
	check(not rules.observe(f.initial),"disposed rejects observations")
	renderer.clear_all()
	var file := FileAccess.open("res://validation.json",FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks":checks,"nativeAdapter":"pending"}))
	quit(1 if checks.any(func(c): return not c.passed) else 0)
