extends SceneTree
var checks: Array = []
func check(value: bool, label: String) -> void:
	checks.append({"name":label,"passed":value})
	if not value: push_error(label)
func _initialize() -> void: call_deferred("run")
func frame(name: String) -> Image:
	await process_frame
	await RenderingServer.frame_post_draw
	var image := root.get_texture().get_image()
	image.save_png("res://"+name+".png")
	return image
func animated_cases(texture: Texture2D) -> void:
	var controller = load("res://effect_controller.gd").new()
	root.add_child(controller)
	var blue_image := Image.create(16,16,false,Image.FORMAT_RGBA8)
	blue_image.fill(Color.BLUE)
	var blue := ImageTexture.create_from_image(blue_image)
	var frames: Array = [texture,blue]
	var durations: Array = [0.25,0.5]
	check(controller.register_animated_overlay("loop",frames,durations,Vector2(20,0),Vector2.ONE,true),"animated registration")
	check(controller.register_animated_overlay("hold",frames,durations,Vector2(20,0),Vector2.ONE,false),"nonloop registration")
	var invalids: Array = [[],[texture],[texture,null],[texture,"bad"],Array(),frames]
	invalids[4]=[]
	invalids[4].resize(65)
	invalids[4].fill(texture)
	var unequal := ImageTexture.create_from_image(Image.create(8,8,false,Image.FORMAT_RGBA8))
	invalids[5]=[texture,unequal]
	for index in range(invalids.size()):
		check(not controller.register_animated_overlay("badframes",invalids[index],[0.25,0.5],Vector2.ZERO,Vector2.ONE,true),"reject frame bounds "+str(index))
	for bad in [[0.25],[0.0,0.5],[-1,0.5],[NAN,0.5],[INF,0.5],["bad",0.5],[0.001,0.5],[10.1,0.5],[6,6]]:
		check(not controller.register_animated_overlay("badduration",frames,bad,Vector2.ZERO,Vector2.ONE,true),"reject duration "+str(bad))
	check(not controller.register_animated_overlay("loop",frames,durations,Vector2.ZERO,Vector2.ONE,true),"reject duplicate animated ID")
	check(not controller.register_animated_overlay("",frames,durations,Vector2.ZERO,Vector2.ONE,true),"reject empty animated ID")
	check(not controller.register_animated_overlay("badtransform",frames,durations,Vector2(INF,0),Vector2.ONE,true),"reject animated offset")
	check(not controller.register_animated_overlay("badtransform",frames,durations,Vector2.ZERO,Vector2(0,1),true),"reject animated scale")
	check(not controller.register_animated_overlay("badtransform",frames,durations,Vector2(4097,0),Vector2.ONE,true),"reject animated offset magnitude")
	check(not controller.register_animated_overlay("badtransform",frames,durations,Vector2.ZERO,Vector2(17,1),true),"reject animated scale upper bound")
	check(not controller.register_animated_overlay("badtransform",frames,durations,Vector2.ZERO,Vector2(NAN,1),true),"reject animated scale nonfinite")
	var wide := ImageTexture.create_from_image(Image.create(4097,1,false,Image.FORMAT_RGBA8))
	check(not controller.register_animated_overlay("dimensions",[wide,wide],durations,Vector2.ZERO,Vector2.ONE,true),"reject oversized frame dimensions")
	check(not controller.register_animated_overlay("dimensions",[ImageTexture.new(),ImageTexture.new()],durations,Vector2.ZERO,Vector2.ONE,true),"reject empty frame dimensions")
	check(controller.register_animated_overlay("badframes",frames,durations,Vector2.ZERO,Vector2.ONE,true),"invalid registration leaves catalog untouched")
	var big := ImageTexture.create_from_image(Image.create(4096,4096,false,Image.FORMAT_RGBA8))
	check(not controller.register_animated_overlay("pixels",[big,big],durations,Vector2.ZERO,Vector2.ONE,true),"cumulative pixel cap")
	var capacity = load("res://effect_controller.gd").new()
	root.add_child(capacity)
	var small := ImageTexture.create_from_image(Image.create(1,1,false,Image.FORMAT_RGBA8))
	var many: Array = []
	var fast: Array = []
	many.resize(64)
	many.fill(small)
	fast.resize(64)
	fast.fill(1.0/240.0)
	check(capacity.register_animated_overlay("maxframes",many,fast,Vector2(4096,0),Vector2(16,16),true),"accept maximum frame count and transform bounds")
	check(capacity.register_animated_overlay("maxduration",frames,[5,5],Vector2.ZERO,Vector2.ONE,false),"accept duration sum bound")
	for index in range(62):
		check(capacity.register_tint("fill"+str(index),Color.WHITE),"mixed catalog slot "+str(index))
	check(not capacity.register_animated_overlay("full",frames,[0.25,0.5],Vector2.ZERO,Vector2.ONE,true),"animated respects mixed catalog capacity")
	capacity.free()
	frames.clear()
	durations[0]=9.0
	var actor := Sprite2D.new()
	actor.texture=texture
	actor.position=Vector2(32,32)
	root.add_child(actor)
	var other := Sprite2D.new()
	other.texture=texture
	other.position=Vector2(96,32)
	root.add_child(other)
	var selected: Array[String] = ["loop"]
	check(controller.apply_active(actor,selected),"animated application")
	var start: Image = await frame("animated-start")
	check(start.get_pixel(52,32).r>0.9,"animation starts frame zero")
	check(controller.advance(0.25),"advance exact boundary")
	check(controller.apply_active(actor,selected),"repeat active selection")
	check(controller.apply_projectile("independent",other,selected,0.25),"independent animated owner")
	var boundary: Image = await frame("animated-boundary")
	check(boundary.get_pixel(52,32).b>0.9 and boundary.get_pixel(52,32).r<0.1,"boundary advances and repeated observation retains phase")
	check(boundary.get_pixel(116,32).r>0.9,"new owner starts independent phase")
	check(boundary.get_pixel(32,32)==start.get_pixel(32,32),"animated overlay leaves base unchanged")
	check(controller.advance(0.75),"advance loop wrap")
	var wrapped: Image = await frame("animated-wrap")
	check(wrapped.get_pixel(52,32).r>0.9 and wrapped.get_pixel(116,32).r<0.1,"loop wrap and independent phase")
	var hold: Array[String] = ["hold"]
	check(controller.apply_active(actor,hold),"selection change resets animation")
	var changed: Image = await frame("animated-change")
	check(changed.get_pixel(52,32).r>0.9 and actor.get_child_count()==1,"replacement starts frame zero with one overlay")
	check(controller.advance(2.0),"advance nonloop end")
	var ended: Image = await frame("animated-end")
	check(ended.get_pixel(52,32).r<0.1 and ended.get_pixel(52,32).b>0.9,"nonloop holds final frame")
	check(not controller.register_animated_overlay("late",[texture,blue],[0.25,0.5],Vector2.ZERO,Vector2.ONE,true),"animated catalog sealed")
	controller.clear_all()
	check(actor.get_child_count()==0 and other.get_child_count()==0,"animated teardown removes nodes")
	actor.free()
	other.free()
	controller.free()
func run() -> void:
	var script = load("res://effect_controller.gd")
	var controller = script.new()
	root.add_child(controller)
	if not controller.has_method("register_animated_overlay"):
		check(false,"animated overlay API exists")
		var missing := FileAccess.open("res://validation.json",FileAccess.WRITE)
		missing.store_string(JSON.stringify({"checks":checks}))
		missing.close()
		quit(1)
		return
	var actor := Sprite2D.new()
	var image := Image.create(16,16,false,Image.FORMAT_RGBA8)
	image.fill(Color.WHITE)
	var texture := ImageTexture.create_from_image(image)
	actor.texture=texture
	actor.position=Vector2(32,32)
	root.add_child(actor)
	var other := Sprite2D.new()
	other.texture=texture
	other.position=Vector2(96,32)
	root.add_child(other)
	check(controller.register_tint("red",Color(1,0,0,1)),"register tint")
	check(controller.register_overlay("overlay",texture,Vector2(20,0),Vector2.ONE),"register overlay")
	var selected: Array[String] = ["red","overlay"]
	check(controller.apply_active(actor,selected),"apply active")
	var applied: Image = await frame("active")
	check(applied.get_pixel(32,32).r>0.9 and applied.get_pixel(32,32).g<0.1,"rendered tint")
	check(applied.get_pixel(52,32).r>0.9,"rendered overlay")
	check(applied.get_pixel(96,32).g>0.9,"shared texture other instance unchanged")
	check(controller.apply_projectile("attack:gen:arrow",other,selected,0.0),"snapshot apply")
	selected.clear()
	check(controller.apply_active(actor,selected),"active removal")
	var retained: Image = await frame("snapshot")
	check(retained.get_pixel(32,32).g>0.9 and retained.get_pixel(52,32).r<0.1,"active frame restored and overlay removed")
	check(retained.get_pixel(96,32).g<0.1,"projectile selection copied")
	check(not controller.advance(-1.0),"clock rollback rejected")
	check(controller.advance(0.0),"paused clock")
	check(other.modulate.g==0.0,"pause retains presentation")
	check(controller.advance(10.0),"expiry")
	var restored: Image = await frame("restored")
	check(restored.get_pixel(96,32).g>0.9 and restored.get_pixel(116,32).r<0.1,"expired frame restored")
	check(not controller.register_tint("late",Color.WHITE),"catalog sealed")
	var invalid: Array[String] = ["missing"]
	check(not controller.apply_active(actor,invalid) and actor.modulate==Color.WHITE,"unknown selection atomic rejection")
	controller.clear_all()
	check(actor.texture==texture and other.texture==texture,"shared resource unchanged")
	actor.modulate=Color(0.5,0.7,0.8,1)
	var tint_only: Array[String] = ["red"]
	check(controller.apply_active(actor,tint_only),"apply with original modulation")
	controller.clear_all()
	check(actor.modulate==Color(0.5,0.7,0.8,1),"restore exact original modulation")
	check(controller.apply_projectile("immutable",other,tint_only,10.0),"capture owner")
	check(controller.apply_projectile("immutable",other,tint_only,10.0),"duplicate owner idempotent")
	check(not controller.apply_projectile("immutable",other,selected,10.0),"conflicting owner rejected")
	controller.remove_projectile("immutable")
	check(other.modulate==Color.WHITE,"explicit projectile removal restores")
	var targets: Array[Node2D] = []
	for index in range(33):
		var target := Node2D.new()
		root.add_child(target)
		targets.append(target)
		var accepted: bool = controller.apply_projectile("capacity"+str(index),target,tint_only,10.0)
		check(accepted==(index<32),"owner capacity "+str(index))
	controller.clear_all()
	check(targets.all(func(target): return target.modulate==Color.WHITE),"bulk teardown restores all owners")
	check(controller.apply_projectile("dead",targets[0],tint_only,10.0),"dead target capture")
	targets[0].free()
	check(controller.advance(10.0),"dead target cleanup")
	controller.clear_all()
	actor.free()
	other.free()
	await animated_cases(texture)
	var file := FileAccess.open("res://validation.json",FileAccess.WRITE)
	file.store_string(JSON.stringify({"checks":checks,"capabilities":["tint","overlay"],"integration":"pending trusted adapter and compiler wiring"}))
	file.close()
	quit(1 if checks.any(func(c): return not c.passed) else 0)
