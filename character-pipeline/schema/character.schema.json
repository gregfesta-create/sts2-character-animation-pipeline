{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character pipeline version 1",
  "type": "object",
  "properties": {
    "version": {
      "enum": [
        1
      ],
      "type": "integer"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "units": {
          "enum": [
            "pixels"
          ]
        },
        "xAxis": {
          "enum": [
            "right"
          ]
        },
        "yAxis": {
          "enum": [
            "down"
          ]
        },
        "rotation": {
          "enum": [
            "clockwise-radians"
          ]
        }
      },
      "required": [
        "width",
        "height",
        "units",
        "xAxis",
        "yAxis",
        "rotation"
      ],
      "additionalProperties": false
    },
    "anatomy": {
      "type": "object",
      "properties": {
        "template": {
          "$ref": "#/$defs/id"
        },
        "roles": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "required": [
        "template",
        "roles"
      ],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "palette": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "proportions": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "outline": {
          "type": "object",
          "properties": {
            "width": {
              "type": "number",
              "minimum": 0
            },
            "color": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          },
          "required": [
            "width",
            "color"
          ],
          "additionalProperties": false
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "shading": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "lightDirection": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "resolution": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "artwork": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "existing",
            "layered",
            "comfyui"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "workflow": {
          "$ref": "#/$defs/id"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "negativePrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "referenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "settings": {
          "type": "object",
          "properties": {
              "backgroundRemoval": {
                "type": "boolean"
              },
            "steps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "cfg": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "denoise": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "parts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/part"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "poseGroups": {
      "type": "array",
      "items": { "$ref": "#/$defs/poseGroup" },
      "maxItems": 64
    },
    "bones": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bone"
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "animations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/animation"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "sockets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/socket"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "assembly": { "$ref": "#/$defs/assembly" },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/component"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "visualStates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/visualState"
      },
      "minItems": 0,
      "maxItems": 10000
    },
    "export": {
      "type": "object",
      "properties": {
        "target": {
          "enum": [
            "godot",
            "sts2"
          ]
        },
        "playback": {
          "enum": [
            "player",
            "tree"
          ]
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "sounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sound"
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "polylines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/polyline"
      },
      "minItems": 0,
      "maxItems": 256
    },
    "projectiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/projectile"
      },
      "minItems": 0,
      "maxItems": 256
    }
  },
  "required": [
    "version",
    "id",
    "revision",
    "description",
    "canvas",
    "anatomy",
    "style",
    "references",
    "artwork",
    "parts",
    "bones",
    "animations",
    "sockets",
    "components",
    "visualStates",
    "export"
  ],
  "additionalProperties": false,
  "$defs": {
    "assembly": {
      "type": "object",
      "properties": {
        "version": { "type": "integer", "enum": [1] },
        "styleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "eventNames": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/id" } },
        "descriptors": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/assemblyDescriptor" } }
      },
      "required": ["version", "styleHash", "eventNames", "descriptors"],
      "additionalProperties": false
    },
    "assemblyDescriptor": {
      "type": "object",
      "properties": {
        "version": { "type": "integer", "enum": [1] },
        "type": { "$ref": "#/$defs/id" },
        "spec": { "type": "string", "maxLength": 4096, "pattern": "^([A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.json$" },
        "mount": { "$ref": "#/$defs/transform" },
        "dimensions": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0.000001, "maximum": 1000000 } },
        "styleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "eventNames": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/id" } },
        "layer": { "type": "integer", "minimum": -4096, "maximum": 4096 },
        "inheritance": { "$ref": "#/$defs/assemblyInheritance" },
        "transitions": { "$ref": "#/$defs/transitionProfiles" }
      },
      "required": ["version", "type", "spec", "mount", "dimensions", "styleHash", "eventNames", "layer", "inheritance"],
      "additionalProperties": false
    },
    "transitionProfiles": {
      "type": "object",
      "properties": {
        "install": {
          "$ref": "#/$defs/transitionProfile"
        },
        "remove": {
          "$ref": "#/$defs/transitionProfile"
        },
        "replace": {
          "$ref": "#/$defs/transitionProfile"
        },
        "upgrade": {
          "$ref": "#/$defs/transitionProfile"
        },
        "repair": {
          "$ref": "#/$defs/transitionProfile"
        },
        "destroy": {
          "$ref": "#/$defs/transitionProfile"
        },
        "damage": {
          "$ref": "#/$defs/transitionProfile"
        },
        "visual": {
          "$ref": "#/$defs/transitionProfile"
        }
      },
      "additionalProperties": false
    },
    "transitionProfile": {
      "type": "object",
      "properties": {
        "duration": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "phases": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/transitionPhase"
          }
        }
      },
      "required": [
        "duration",
        "phases"
      ],
      "additionalProperties": false
    },
    "transitionPhase": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "clip": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "id",
        "time"
      ],
      "additionalProperties": false
    },
    "assemblyInheritance": {
      "type": "object",
      "properties": { "position": { "type": "boolean" }, "rotation": { "type": "boolean" }, "scale": { "type": "boolean" } },
      "required": ["position", "rotation", "scale"],
      "additionalProperties": false
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "vec": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "transform": {
      "type": "object",
      "properties": {
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "rotation": {
          "type": "number"
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "position",
        "rotation",
        "scale"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "alphaBounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "cropTranslation": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pivot": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "pixelsPerUnit": {
          "type": "number",
          "minimum": 0.000001
        },
        "prepared": {
          "type": "boolean",
          "default": false
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "description": "Raw input images may contain only path; W2 enriches them automatically. prepared:true is the prepared-art boundary and requires complete registration metadata. alphaBounds is [left, top, right, bottom] in source pixels, right/bottom exclusive; all supplied bounds must be inside known dimensions. cropTranslation is source-to-cropped translation; pivot remains explicit in canonical pixels; pixelsPerUnit is positive.",
      "if": {
        "properties": {
          "prepared": {
            "const": true
          }
        },
        "required": [
          "prepared"
        ]
      },
      "then": {
        "required": [
          "width",
          "height",
          "alphaBounds",
          "cropTranslation",
          "pivot",
          "pixelsPerUnit"
        ]
      }
    },
    "influence": {
      "type": "object",
      "properties": {
        "bone": {
          "$ref": "#/$defs/id"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "bone",
        "weight"
      ],
      "additionalProperties": false
    },
    "mesh": {
      "type": "object",
      "properties": {
        "vertices": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 10000
        },
        "uv": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 3,
          "maxItems": 10000
        },
        "triangles": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 1,
          "maxItems": 20000
        },
        "weights": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/influence"
            },
            "minItems": 1,
            "maxItems": 32
          },
          "minItems": 3,
          "maxItems": 10000
        }
      },
      "required": [
        "vertices",
        "uv",
        "triangles",
        "weights"
      ],
      "additionalProperties": false
    },
    "bone": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "rest": {
          "$ref": "#/$defs/transform"
        },
        "length": {
          "type": "number",
          "minimum": 0.000001
        },
        "limits": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "id",
        "parent",
        "rest",
        "length"
      ],
      "additionalProperties": false
    },
    "skinning": {
      "type": "object",
      "properties": {
        "bones": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"},
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "axis": {"enum": ["x", "y"]},
        "segments": {"type": "integer", "minimum": 1, "maximum": 15},
        "pinStart": {"type": "boolean"},
        "pinEnd": {"type": "boolean"}
      },
      "required": ["bones", "axis", "segments"],
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "$ref": "#/$defs/id"
        },
        "bone": {
          "$ref": "#/$defs/id"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "mask": {
          "$ref": "#/$defs/image"
        },
        "requiredSurfaceMask": {
          "type": "object",
          "properties": {
            "path": {"type": "string", "minLength": 1, "maxLength": 4096}
          },
          "required": ["path"],
          "additionalProperties": false
        },
        "pivot": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "layer": {
          "type": "integer"
        },
        "mesh": {
          "$ref": "#/$defs/mesh"
        },
        "skinning": {
          "$ref": "#/$defs/skinning"
        },
        "overlaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "id",
        "role",
        "bone",
        "pivot",
        "layer"
      ],
      "additionalProperties": false
    },
    "key": {
      "type": "object",
      "properties": {
        "time": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/$defs/vec"
            }
          ]
        },
        "easing": {
          "enum": [
            "linear",
            "in",
            "out",
            "inOut",
            "step"
          ]
        }
      },
      "required": [
        "time",
        "value"
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "bone": {
          "$ref": "#/$defs/id"
        },
        "property": {
          "enum": [
            "position",
            "rotation",
            "scale"
          ]
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          },
          "minItems": 1,
          "maxItems": 600
        }
      },
      "required": [
        "bone",
        "property",
        "keys"
      ],
      "additionalProperties": false
    },
    "event": {
      "anyOf": [
        {
          "$ref": "#/$defs/markerEvent"
        },
        {
          "$ref": "#/$defs/soundEvent"
        },
        {
          "$ref": "#/$defs/projectileEvent"
        }
      ]
    },
    "poseGroup": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "parts": { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 2, "maxItems": 64 },
        "defaultPart": { "$ref": "#/$defs/id" }
      },
      "required": ["id", "parts", "defaultPart"],
      "additionalProperties": false
    },
    "poseTrack": {
      "type": "object",
      "properties": {
        "group": { "$ref": "#/$defs/id" },
        "keys": {
          "type": "array", "minItems": 1, "maxItems": 128,
          "items": {
            "type": "object",
            "properties": {
              "time": { "type": "number", "minimum": 0 },
              "part": { "$ref": "#/$defs/id" }
            },
            "required": ["time", "part"],
            "additionalProperties": false
          }
        }
      },
      "required": ["group", "keys"],
      "additionalProperties": false
    },
    "animation": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "duration": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 600
        },
        "poseTracks": {
          "type": "array",
          "items": { "$ref": "#/$defs/poseTrack" },
          "maxItems": 64
        },
        "blendIn": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "loop": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          },
          "minItems": 0,
          "maxItems": 10000
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          },
          "minItems": 0,
          "maxItems": 10000
        }
      },
      "required": [
        "id",
        "duration",
        "loop",
        "tracks",
        "events"
      ],
      "additionalProperties": false
    },
    "socket": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "bone": {
          "$ref": "#/$defs/id"
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "maxItems": 10000
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "inheritance": {
          "type": "object",
          "properties": {
            "position": {
              "type": "boolean"
            },
            "rotation": {
              "type": "boolean"
            },
            "scale": {
              "type": "boolean"
            }
          },
          "required": [
            "position",
            "rotation",
            "scale"
          ],
          "additionalProperties": false
        },
        "layer": {
          "type": "integer"
        },
        "envelope": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "id",
        "bone",
        "transform",
        "types",
        "capacity",
        "inheritance"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "socket": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "$ref": "#/$defs/id"
        },
        "spec": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "transform": {
          "$ref": "#/$defs/transform"
        }
      },
      "required": [
        "id",
        "socket",
        "type",
        "spec"
      ],
      "additionalProperties": false
    },
    "visualState": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
