{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "characterId", "mechanicsFingerprint", "inspectionVersion", "decisions"],
  "properties": {
    "version": {"type": "integer", "const": 1},
    "characterId": {"type": "string", "minLength": 1, "maxLength": 2048},
    "mechanicsFingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "inspectionVersion": {"type": "string", "const": "1"},
    "decisions": {
      "type": "array", "minItems": 1, "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mechanicKey", "evidenceIds", "outcome", "clipIds", "reason"],
        "properties": {
          "mechanicKey": {"type": "string", "minLength": 1, "maxLength": 2048},
          "evidenceIds": {"type": "array", "minItems": 1, "maxItems": 2000, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
          "outcome": {"type": "string", "enum": ["animate", "none", "unresolved"]},
          "clipIds": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$", "minLength": 1, "maxLength": 64}},
          "reason": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "allOf": [{"if": {"properties": {"outcome": {"const": "animate"}}}, "then": {"properties": {"clipIds": {"minItems": 1}}}, "else": {"properties": {"clipIds": {"maxItems": 0}}}}]
      }
    }
  }
}
