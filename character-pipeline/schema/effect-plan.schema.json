{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "characterId": {
      "type": "string",
      "maxLength": 256
    },
    "mechanicsFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inspectionVersion": {
      "type": "string",
      "maxLength": 256
    },
    "adapterContractVersion": {
      "type": "string",
      "maxLength": 256
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "maxLength": 4096
          },
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "symbol": {
            "type": "string",
            "maxLength": 16384
          },
          "lineStart": {
            "type": "integer",
            "minimum": 1
          },
          "lineEnd": {
            "type": "integer",
            "minimum": 1
          },
          "excerpt": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "id",
          "path",
          "hash",
          "symbol",
          "lineStart",
          "lineEnd",
          "excerpt"
        ]
      },
      "maxItems": 2000,
      "minItems": 0
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256
          },
          "mechanicKey": {
            "type": "string",
            "maxLength": 1024
          },
          "outcome": {
            "type": "string",
            "enum": [
              "effect",
              "none",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 16384
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 256
            },
            "maxItems": 2000,
            "minItems": 1
          },
          "bindingId": {
            "type": "string",
            "maxLength": 256
          },
          "rule": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "effectIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 256
                },
                "maxItems": 64,
                "minItems": 1
              },
              "condition": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "present",
                      "amountAtLeast"
                    ]
                  },
                  "threshold": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "type"
                ]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "whileActive",
                  "attackSnapshot"
                ]
              },
              "socketId": {
                "type": "string",
                "maxLength": 256
              },
              "channel": {
                "type": "string",
                "maxLength": 256
              },
              "priority": {
                "type": "integer",
                "minimum": -1000,
                "maximum": 1000
              }
            },
            "required": [
              "effectIds",
              "condition",
              "scope",
              "socketId",
              "channel",
              "priority"
            ]
          }
        },
        "required": [
          "id",
          "mechanicKey",
          "outcome",
          "reason",
          "evidenceIds"
        ]
      },
      "maxItems": 1000,
      "minItems": 0
    }
  },
  "required": [
    "version",
    "characterId",
    "mechanicsFingerprint",
    "inspectionVersion",
    "adapterContractVersion",
    "evidence",
    "decisions"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
